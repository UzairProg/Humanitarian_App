# ==============================================================================
# AL-HUSSEINIYA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This file serves as the canonical reference for all environment variables.
# Copy this file to .env for local development:
#   cp .env.example .env
#
# CRITICAL: DO NOT COMMIT REAL SECRETS, PRIVATE KEYS, OR PRODUCTION CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Al-Husseiniya
APP_PORT=4000
APP_BASE_URL=http://localhost:4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE (MongoDB)
# ------------------------------------------------------------------------------
# For local dev with MongoDB or Atlas:
MONGODB_URI=mongodb://localhost:27017/al_husseiniya_dev
MONGODB_DATABASE=al_husseiniya_dev

# Set to 'true' to use in-memory MongoDB server for testing or standalone zero-dependency execution
USE_MEMORY_DB=true

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# In production, use cryptographically secure random 256-bit strings
JWT_ACCESS_SECRET=al_husseiniya_dev_jwt_access_secret_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=al_husseiniya_dev_jwt_refresh_secret_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# CACHE & QUEUES (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# ------------------------------------------------------------------------------
# FILE STORAGE ABSTRACTION (Local / S3)
# ------------------------------------------------------------------------------
# Storage driver: 'local' or 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_MAX_FILE_SIZE_MB=10

# S3 Configuration (Required if STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=

# ------------------------------------------------------------------------------
# NOTIFICATIONS & COMMUNICATIONS
# ------------------------------------------------------------------------------
# Email provider: 'dev-console' | 'smtp' | 'sendgrid' | 'ses'
EMAIL_PROVIDER=dev-console
EMAIL_FROM=no-reply@alhusseiniya.org
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# SMS provider: 'dev-console' | 'twilio'
SMS_PROVIDER=dev-console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notification provider: 'dev-console' | 'fcm'
PUSH_PROVIDER=dev-console
FCM_SERVER_KEY=

# ------------------------------------------------------------------------------
# MAPS & LOCATION
# ------------------------------------------------------------------------------
# Map provider: 'mock' | 'mapbox' | 'google-maps'
MAP_PROVIDER=mock
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
ENABLE_AUDIT_LOGGING=true
